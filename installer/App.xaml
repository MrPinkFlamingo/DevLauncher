<Application x:Class="DevLauncherInstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <!-- Colores Principales del Tema Oscuro Minecraft -->
        <SolidColorBrush x:Key="BgDark" Color="#121316"/>
        <SolidColorBrush x:Key="BgCard" Color="#1A1C23"/>
        <SolidColorBrush x:Key="BgInput" Color="#222530"/>
        <SolidColorBrush x:Key="BorderDark" Color="#2E3342"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="McGreen" Color="#22C55E"/>
        <SolidColorBrush x:Key="McGreenHover" Color="#16A34A"/>
        <SolidColorBrush x:Key="McGreenPressed" Color="#15803D"/>
    </Application.Resources>
</Application>
