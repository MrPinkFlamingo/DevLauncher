<Window x:Class="DevLauncherCS.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DevLauncher - Minecraft Launcher" 
        Height="700" Width="1020"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        FontFamily="Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Estilos de botones redondeados -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,0,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtabButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A1A1AA"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0,14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27272A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterMiniButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#27272A"/>
            <Setter Property="Foreground" Value="#D4D4D8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3F3F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlayBigButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2ECC71"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#27AE60"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#555555"/>
                                <Setter Property="Foreground" Value="#999999"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ToggleButton para el ComboBox oscuro -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="6" Background="#202024" BorderBrush="#3F3F46" BorderThickness="1" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#A1A1AA" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#2ECC71" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#2ECC71" />
                </Trigger>
                <Trigger Property="IsChecked" Value="true">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#2ECC71" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Estilo de cada elemento (versión) dentro del desplegable -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="true"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="Background" Value="#202024"/>
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#2ECC71"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Border" Property="Background" Value="#27AE60"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo general del ComboBox con Popup oscuro -->
        <Style x:Key="DarkComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#202024"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0,0,0"/>
            <Setter Property="MaxDropDownHeight" Value="280"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="true"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource ComboBoxToggleButton}" 
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"  
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              TextElement.Foreground="White"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.FontSize="12" />
                            <Popup Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" 
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#18181B"
                                            BorderThickness="1"
                                            BorderBrush="#3F3F46"
                                            CornerRadius="8"
                                            Padding="4"
                                            Margin="0,4,0,0">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <VirtualizingStackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. BARRA LATERAL (SIDEBAR) -->
        <Border Grid.Column="0" Background="#121214" BorderBrush="#202024" BorderThickness="0,0,1,0">
            <Grid Margin="12,15,12,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Perfil de Usuario -->
                <Border Grid.Row="0" Background="#202024" CornerRadius="10" Padding="10" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6" ClipToBounds="True" Background="#27272A" HorizontalAlignment="Left">
                            <Image x:Name="imgAvatar" Source="pack://application:,,,/DevLauncher;component/assets/steve_head.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Border>

                        <!-- Nickname y Estado -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBox x:Name="txtUsername" Text="Steve" FontSize="13" FontWeight="Bold" 
                                     Foreground="White" Background="Transparent" BorderThickness="0,0,0,1" 
                                     BorderBrush="#52525B" Padding="2" LostFocus="TxtUsername_LostFocus"/>
                            <TextBlock Text="● No Premium" FontSize="10" Foreground="#2ECC71" Margin="2,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Botón Rápido Cambiar Skin -->
                <Button x:Name="btnQuickChangeSkin" Grid.Row="1" Style="{StaticResource FilterMiniButtonStyle}" 
                        Content=" 🎨  Cambiar Skin" Height="32" Margin="0,0,0,16" Click="BtnQuickChangeSkin_Click"/>

                <!-- Título Sección Juegos -->
                <TextBlock Grid.Row="2" Text="JUEGOS" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="8,0,0,8"/>

                <!-- Botón Java Edition -->
                <Button x:Name="btnNavJava" Grid.Row="3" Style="{StaticResource SidebarButtonStyle}" 
                        Content=" 🟩  Minecraft: Java" Background="#27272A" Click="BtnNavJava_Click"/>

                <!-- Botón Ajustes Abajo -->
                <Button x:Name="btnNavSettings" Grid.Row="5" Style="{StaticResource SidebarButtonStyle}" 
                        Content=" ⚙️  Ajustes" Click="BtnNavSettings_Click"/>
            </Grid>
        </Border>

        <!-- 2. CONTENEDOR PRINCIPAL DERECHO -->
        <Grid Grid.Column="1" Background="#18181B">
            <!-- ============================================== -->
            <!-- VISTA 1: MINECRAFT JAVA EDITION -->
            <!-- ============================================== -->
            <Grid x:Name="gridJava" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sub-barra superior de navegación -->
                <Border Grid.Row="0" Background="#121214">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <Button x:Name="btnSubJugar" Style="{StaticResource SubtabButtonStyle}" Content="JUGAR" Background="#27272A" Foreground="White" Click="BtnSubJugar_Click"/>
                            <Button x:Name="btnSubInst" Style="{StaticResource SubtabButtonStyle}" Content="INSTALACIONES" Margin="6,0,0,0" Click="BtnSubInst_Click"/>
                            <Button x:Name="btnSubSkins" Style="{StaticResource SubtabButtonStyle}" Content="ASPECTOS (SKINS)" Margin="6,0,0,0" Click="BtnSubSkins_Click"/>
                            <Button x:Name="btnSubLogs" Style="{StaticResource SubtabButtonStyle}" Content="REGISTROS" Margin="6,0,0,0" Click="BtnSubLogs_Click"/>
                        </StackPanel>

                        <!-- Botón GitHub en la parte derecha -->
                        <Button x:Name="btnGithub" Style="{StaticResource SubtabButtonStyle}" HorizontalAlignment="Right" Margin="0,0,15,0" Click="BtnGithub_Click" ToolTip="Visitar GitHub de MrPinkFlamingo">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"
                                      Data="M12,2A10,10 0 0,0 2,12C2,16.42 4.87,20.17 8.84,21.5C9.34,21.58 9.5,21.27 9.5,21C9.5,20.77 9.5,20.14 9.5,19.31C6.73,19.91 6.14,17.97 6.14,17.97C5.68,16.81 5.03,16.5 5.03,16.5C4.12,15.88 5.1,15.9 5.1,15.9C6.1,15.97 6.63,16.93 6.63,16.93C7.5,18.45 8.97,18 9.54,17.76C9.63,17.11 9.89,16.67 10.17,16.42C7.95,16.17 5.62,15.31 5.62,11.5C5.62,10.39 6,9.5 6.65,8.79C6.55,8.54 6.2,7.5 6.75,6.15C6.75,6.15 7.59,5.88 9.5,7.17C10.29,6.95 11.15,6.84 12,6.84C12.85,6.84 13.71,6.95 14.5,7.17C16.41,5.88 17.25,6.15 17.25,6.15C17.8,7.5 17.45,8.54 17.35,8.79C18,9.5 18.38,10.39 18.38,11.5C18.38,15.32 16.04,16.16 13.81,16.41C14.17,16.72 14.5,17.33 14.5,18.26C14.5,19.6 14.5,20.68 14.5,21C14.5,21.27 14.66,21.59 15.17,21.5C19.14,20.16 22,16.42 22,12A10,10 0 0,0 12,2Z"/>
                                <TextBlock Text="GitHub" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Sub-pestaña: JUGAR -->
                <Grid x:Name="gridSubJugar" Grid.Row="1" Visibility="Visible" Margin="15,15,15,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="84"/>
                    </Grid.RowDefinitions>

                    <!-- Hero Banner -->
                    <Border Grid.Row="0" CornerRadius="12" ClipToBounds="True" Background="#141416" Margin="0,0,0,12">
                        <Grid>
                            <!-- Imagen de fondo -->
                            <Image Source="pack://application:,,,/DevLauncher;component/assets/java_hero.jpg" Stretch="UniformToFill"/>

                            <!-- Tarjeta superior de título -->
                            <Border Background="#D0141416" CornerRadius="10" Padding="18,12,18,12" 
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0">
                                <StackPanel>
                                    <TextBlock Text="MINECRAFT" FontFamily="Impact" FontSize="36" Foreground="White"/>
                                    <TextBlock Text="JAVA EDITION" FontSize="12" FontWeight="Bold" Foreground="#2ECC71"/>
                                </StackPanel>
                            </Border>

                            <!-- Tarjeta de estado y progreso -->
                            <Border Background="#E0141416" CornerRadius="10" Padding="15,10,15,10"
                                    VerticalAlignment="Bottom" Margin="20,0,20,20">
                                <StackPanel>
                                    <TextBlock x:Name="txtStatus" Text="Listo para jugar." FontSize="12" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6"/>
                                    <ProgressBar x:Name="pbProgress" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#2ECC71" Background="#27272A" BorderThickness="0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Barra de Lanzamiento Inferior -->
                    <Border Grid.Row="1" Background="#121214" CornerRadius="12" Padding="15,10,15,10">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Selector de versiones -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VERSIÓN / INSTALACIÓN:" FontSize="10" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="cbVersions" Width="185" Height="34" 
                                              Style="{StaticResource DarkComboBoxStyle}"
                                              Margin="0,0,8,0"
                                              SelectionChanged="CbVersions_SelectionChanged"/>
                                    <Button x:Name="btnFilterInstaladas" Style="{StaticResource FilterMiniButtonStyle}" Content="Instaladas" Background="#3F3F46" Click="BtnFilterInstaladas_Click"/>
                                    <Button x:Name="btnFilterPopulares" Style="{StaticResource FilterMiniButtonStyle}" Content="Populares" Margin="4,0,0,0" Click="BtnFilterPopulares_Click"/>
                                    <Button x:Name="btnFilterTodas" Style="{StaticResource FilterMiniButtonStyle}" Content="Todas" Margin="4,0,0,0" Click="BtnFilterTodas_Click"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Slider de RAM -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="txtRamValue" Text="RAM: 4 GB" FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                <Slider x:Name="sliderRam" Minimum="2" Maximum="16" Value="4" Width="130" 
                                        IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,4,0,0"
                                        ValueChanged="SliderRam_ValueChanged"/>
                            </StackPanel>

                            <!-- Botón Jugar Gigante -->
                            <Button x:Name="btnPlayJava" Grid.Column="2" Style="{StaticResource PlayBigButtonStyle}" 
                                    Content="JUGAR" Width="170" Height="52" Click="BtnPlayJava_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Sub-pestaña: INSTALACIONES -->
                <Grid x:Name="gridSubInstalaciones" Grid.Row="1" Visibility="Collapsed" Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock x:Name="txtInstalledCount" Text="Buscando versiones instaladas..." FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource FilterMiniButtonStyle}" Content="🔄 Actualizar" Margin="15,0,0,0" Click="BtnRefreshInstalled_Click"/>
                        <Button Style="{StaticResource FilterMiniButtonStyle}" Content="📁 Abrir Carpeta .minecraft" Margin="8,0,0,0" Click="BtnOpenMcFolder_Click"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="panelInstalledCards"/>
                    </ScrollViewer>
                </Grid>

                <!-- Sub-pestaña: ASPECTOS (SKINS) -->
                <Grid x:Name="gridSubSkins" Grid.Row="1" Visibility="Collapsed" Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Tarjeta Izquierda: Vista Previa de la Skin -->
                    <Border Grid.Column="0" Background="#121214" CornerRadius="12" Padding="20" Margin="0,0,15,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="VISTA PREVIA" FontSize="11" FontWeight="Bold" Foreground="#71717A" Margin="0,0,0,15"/>

                            <!-- Contenedor de Cabeza y Textura -->
                            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Cabeza Ampliada -->
                                <Border Width="110" Height="110" Background="#202024" CornerRadius="12" BorderBrush="#3F3F46" BorderThickness="2" Margin="0,0,0,15">
                                    <Image x:Name="imgSkinHeadPreview" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="10" 
                                           Source="pack://application:,,,/DevLauncher;component/assets/steve_head.png"/>
                                </Border>

                                <!-- Textura Completa -->
                                <Border Width="170" Height="85" Background="#202024" CornerRadius="8" BorderBrush="#27272A" BorderThickness="1" Padding="4">
                                    <Image x:Name="imgSkinFullTexture" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <TextBlock x:Name="txtSkinStatus" Text="Skin activa: Steve (por defecto)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </StackPanel>

                            <Button Grid.Row="2" Style="{StaticResource FilterMiniButtonStyle}" Content="📁 Abrir carpeta .minecraft" Click="BtnOpenMcFolder_Click"/>
                        </Grid>
                    </Border>

                    <!-- Tarjeta Derecha: Cargar y Aplicar -->
                    <Border Grid.Column="1" Background="#121214" CornerRadius="12" Padding="25">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Título -->
                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="Personalizar Skin para tus Mundos" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Carga cualquier skin para verla en tercera persona (pulsando F5) en todos tus mundos." FontSize="11" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Método 1: Archivo local .PNG -->
                            <Border Grid.Row="1" Background="#202024" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Opción 1: Archivo de tu computadora" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                        <TextBlock Text="Selecciona un archivo .png de skin (64x64) descargado de NameMC, Skindex, etc." FontSize="11" Foreground="#71717A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button x:Name="btnChooseSkinFile" Grid.Column="1" Style="{StaticResource FilterMiniButtonStyle}" 
                                            Content="📂 Elegir Archivo .PNG" Height="36" Padding="15,0,15,0" Click="BtnChooseSkinFile_Click"/>
                                </Grid>
                            </Border>

                            <!-- Método 2: Clonar por nombre -->
                            <Border Grid.Row="2" Background="#202024" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Opción 2: Clonar skin de jugador / YouTuber" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                    <TextBlock Text="Escribe el nombre de usuario de cualquier jugador para descargar su skin oficial." FontSize="11" Foreground="#71717A" Margin="0,2,0,8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtPlayerSkinName" Grid.Column="0" Height="36" Background="#27272A" Foreground="White" 
                                                 BorderBrush="#3F3F46" Padding="10,8" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="btnDownloadSkinOnline" Grid.Column="1" Style="{StaticResource FilterMiniButtonStyle}" 
                                                Content="🌐 Descargar Skin" Height="36" Padding="15,0,15,0" Click="BtnDownloadSkinOnline_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Mensaje de estado -->
                            <TextBlock x:Name="txtSkinApplyResult" Grid.Row="3" Text="" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Botón Grande Aplicar -->
                            <Button x:Name="btnApplySkin" Grid.Row="4" Style="{StaticResource PlayBigButtonStyle}" 
                                    Content="✔ APLICAR SKIN A MIS MUNDOS" Height="50" Click="BtnApplySkin_Click"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Sub-pestaña: REGISTROS -->
                <Grid x:Name="gridSubLogs" Grid.Row="1" Visibility="Collapsed" Margin="20">
                    <Border Background="#121214" CornerRadius="10" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Consola de ejecución de Minecraft:" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                            <TextBox x:Name="txtLogs" Grid.Row="1" Background="#101012" Foreground="#2ECC71" FontFamily="Consolas" FontSize="11" 
                                     IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============================================== -->
            <!-- VISTA 2: AJUSTES -->
            <!-- ============================================== -->
            <Grid x:Name="gridSettings" Visibility="Collapsed" Margin="25">
                <Border Background="#121214" CornerRadius="12" Padding="25" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Ajustes de DevLauncher" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Directorio de Minecraft (.minecraft):" FontWeight="Bold" Foreground="White" Margin="0,0,0,4"/>
                        <TextBlock x:Name="txtMcPath" Text="%APPDATA%/.minecraft" Foreground="#A1A1AA" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource FilterMiniButtonStyle}" Content="📂 Abrir carpeta .minecraft" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10" Click="BtnOpenMcFolder_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
